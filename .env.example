# Public website and Supabase browser connection
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Supabase privileged key. Never expose to NEXT_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Razorpay - enable only after hotel merchant account approval
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend email - verify sender domain before sending
RESEND_API_KEY=
EMAIL_FROM=
HOTEL_NOTIFICATION_EMAIL=

# Meta WhatsApp Cloud API - use approved business account and templates
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ALERT_TO=
WHATSAPP_API_VERSION=v22.0

# Protect the Vercel Cron endpoint
CRON_SECRET=

# Optional guest SMS delivery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Analytics 4 and Search Console
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_SITE_VERIFICATION=

# Official public profiles (use hotel-owned URLs only)
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
